# Servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL/MariaDB (Hostinger Business - hPanel > Bases de datos MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_contable
DB_USER=u123456789_appuser
DB_PASSWORD=

# Autenticación
# Obligatorio: mínimo 16 caracteres, secreto y distinto en cada ambiente (el servidor no arranca sin él y avisa si es corto)
JWT_SECRET=cambia_este_valor_por_uno_seguro
JWT_EXPIRES_IN=8h
# Código que se entrega a quien puede crear una empresa nueva desde la pantalla de inicio. Sin él, el registro de empresas queda cerrado.
CODIGO_REGISTRO=
# Clave que el proveedor tecnológico envía en el encabezado x-webhook-secret. Sin ella, los webhooks quedan deshabilitados.
WEBHOOK_SECRET=
# Opcional: orígenes (separados por coma) que pueden llamar la API desde otro sitio. Vacío = solo este mismo sitio.
CORS_ORIGIN=

# Proveedor tecnológico de facturación electrónica (capa adaptadora)
FACTURACION_PROVEEDOR=nombre_del_proveedor
FACTURACION_API_URL=https://api.proveedor.com
FACTURACION_API_KEY=

# Proveedor tecnológico de documento soporte
DOC_SOPORTE_API_URL=
DOC_SOPORTE_API_KEY=

# Proveedor tecnológico de nómina electrónica
NOMINA_API_URL=
NOMINA_API_KEY=
